# Template only. Copy to .env.development / .env.test / .env.production and set real values.
# DATABASE_URL is the single key across all environments (IS §10.1). Dev/prod use Neon
# (TAS §8, Diagram 5); test uses the ephemeral local Docker instance (TAS §9.1 stage 7).
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

OPA_POLICY_WASM_PATH=

LOG_LEVEL=        # info in .env.production

HTTP_PORT=

NODE_ENV=     # test / production respectively
